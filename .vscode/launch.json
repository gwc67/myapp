{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Black Pill F407VE",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            
            // 🔑 ELF 文件路径（必须是 .elf，不是 .hex）
            "executable": "${workspaceRoot}/build/zephyr/zephyr.elf",
            
            // 🔑 使用 OpenOCD 作为 GDB Server
            "servertype": "openocd",
            "serverpath": "D:/Downloads/setup/zephyr-sdk-1.0.1/hosttools/openocd/bin/openocd.exe",
            
            // 🔑 使用你 board 自带的 openocd.cfg
            "configFiles": [
                "${workspaceRoot}/zephyr/boards/others/black_f407ve/support/openocd.cfg"
            ],
            
            // OpenOCD 脚本搜索目录
            "searchDir": [
                "D:/Downloads/setup/zephyr-sdk-1.0.1/hosttools/openocd/share/openocd/scripts"
            ],
            
            // 启动后停在 main 函数
            "runToEntryPoint": "main",
            
            // 可选：按 F5 前自动编译
            "preLaunchTask": "west-build"
        }
    ]
}