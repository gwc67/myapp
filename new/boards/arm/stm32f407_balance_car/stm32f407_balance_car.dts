/dts-v1/;

#include <arm/armv7-m.dtsi>
#include <st/f4/stm32f407Xe.dtsi>
#include <st/f4/stm32f407z(e-g)tx-pinctrl.dtsi>

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/clock/stm32f4_clock.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/pwm/stm32_pwm.h>
#include <dt-bindings/dma/stm32_dma.h>
#include <dt-bindings/reset/stm32f2_4_7_reset.h>
#include <dt-bindings/sensor/qdec_stm32.h>
#include <dt-bindings/power/stm32_pwr.h>

#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";

		key0: key_0 {
			gpios = <&gpioe 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY0";
			zephyr,code = <INPUT_KEY_0>;
		};

		key1: key_1 {
			gpios = <&gpioe 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY1";
			zephyr,code = <INPUT_KEY_1>;
		};

		key2: key_2 {
			gpios = <&gpioe 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY2";
			zephyr,code = <INPUT_KEY_2>;
		};

		key3: key_3 {
			gpios = <&gpioe 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "KEY3";
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	/* motor_a_gpios 是父节点，它只是容器，没有 gpios 属性 */
	/* ain1、ain2、bin1、bin2 是子节点，它们才有 gpios 属性 */
	/* 因此需要使用DEVICE_DT_GET DT 指的是DEVICE_TREE的缩写 */
	/* DEVICE_DT_GET(DT_LABEL(ain1)) */
	motor_a_gpios: motor_a_gpios {
		compatible = "gpio-leds";

		/* ain2: 是节点标签（node label） 用于在其他地方引用这个节点，比如 &ain2 */
		/* ain2 { ... } 是节点名（node name） */
		ain1: ain1 {
			/* PC1 */
			gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
		};

		ain2: ain2 {
			/* PC0 */
			gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
		};
	};

	motor_b_gpios: motor_b_gpios {
		compatible = "gpio-leds";

		bin1: bin1 {
			gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
		};

		bin2: bin2 {
			gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
		};
	};

	/* aliases 是 Device Tree（设备树） 中的一个节点，它的作用是给设备节点起一个简短的别名，方便在代码中引用。 */
	/* DEVICE_DT_GET(DT_ALIAS(ain1)) 中的 DT_ALIAS */
	aliases {
		led0 = &led0;
		encodera = &qdec_e1;
		encoderb = &qdec_e2;
		tim5 = &counter5;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,display = &ssd1306;
		zephyr,console = &usart2;    /* 这里可以修改调试串口是usart2 */
	};
};

&led0 {
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <336>;
	div-p = <2>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};

&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;

		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};

&dma1 {
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <460800>;
	// dmas = <&dma1 6 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	//        <&dma1 5 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	// dma-names = "tx", "rx";
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <500000>;
	status = "okay";
};

&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";

	mpu6050: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
		accel-fs = <2>;		/* +-2g */
		gyro-fs = <250>;	/* +-250°/s */
		smplrt-div = <0>; 	/* 8KHZ (1 + 0) = 8Khz （陀螺仪） 1Khz 加速度计 */
	};
};

&timers2 {
	status = "okay";
	st,prescaler = <84>;

	pwm2: pwm {
		/* compatbile 需要这样写 */
		compatible = "st,stm32-pwm";
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;
		pinctrl-names = "default";
		/* 4 通道 PWM */
		#pwm-cells = <3>;
	};
};
/* 编码器1 ： TIM3 （PA6，PA7） */

&timers3 {
	status = "okay";
	st,prescaler = <0>;

	qdec_e1: qdec {
		compatible = "st,stm32-qdec";  /* mpatible = "st,stm32-qdec" 表示："我是一个 STM32 的 Quadrature Decoder（正交编码器），请用 st,stm32-qdec 这个驱动来初始化我。" */
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;
		pinctrl-names = "default";
		/* 输入滤波 */
		st,input-filter-level = <FDIV32_N8>;
		/* 编码器每转脉冲数 */
		st,counts-per-revolution = <44>;
		/* 编码器模式: 0x1=模式1，0x2 = 模式2，-x3=模式3 (默认，x4计数) */
		st,encoder-mode = <3>;
	};
};

/* 编码器2 ： TIM4 (PD12 , PD13) */

&timers4 {
	status = "okay";
	st,prescaler = <0>;

	qdec_e2: qdec {
		compatible = "st,stm32-qdec";
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pd12 &tim4_ch2_pd13>;
		pinctrl-names = "default";
		st,input-filter-level = <FDIV32_N8>;
		st,counts-per-revolution = <44>;
		st,encoder-mode = <3>;
	};
};

&timers5 {
	status = "okay";
	st,prescaler = <83>;
	st,countermode = <0>;

	counter5: counter {
		compatible = "st,stm32-counter";
		status = "okay";
		label = "COUNTER_5";
	};
};
