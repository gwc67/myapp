   clock-frequency = <100000>;
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x40005800 0x400>;
   clocks = <&rcc (0x040) (1 << 22)>;
   interrupts = <33 0>, <34 0>;
   interrupt-names = "event", "error";
