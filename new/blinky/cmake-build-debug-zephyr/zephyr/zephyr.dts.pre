    #gpio-cells = <2>;
    reg = <0x40020800 0x400>;
    clocks = <&rcc (0x030) (1 << 2)>;
   };

   gpiod: gpio@40020c00 {
    compatible = "st,stm32-gpio";
    gpio-controller;
    #gpio-cells = <2>;
    reg = <0x40020c00 0x400>;
    clocks = <&rcc (0x030) (1 << 3)>;
