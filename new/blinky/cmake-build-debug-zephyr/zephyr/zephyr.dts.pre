    #gpio-cells = <2>;
    reg = <0x40020000 0x400>;
    clocks = <&rcc (0x030) (1 << 0)>;
   };

   gpiob: gpio@40020400 {
    compatible = "st,stm32-gpio";
    gpio-controller;
    #gpio-cells = <2>;
    reg = <0x40020400 0x400>;
    clocks = <&rcc (0x030) (1 << 1)>;
