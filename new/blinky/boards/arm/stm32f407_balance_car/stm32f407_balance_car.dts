/dts-v1/;


#include <st/f4/stm32f407Xe.dtsi>

// 根节点 设备树
// 硬件对象节点
// 容器节点
// /leds/led_0
// led0 节点标签
// 属性
/ {
	//隶属于根节点
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
		};
	};
	/* 容器节点 */
	aliases {
		led0 = &led0;
	};
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};
};

/* 引用标签& */

&led0 {
	status = "okay";
};


&clk_lsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <336>;
	div-p = <2>;
	div-q = <7>;	//这是给USB使用的吧
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};




